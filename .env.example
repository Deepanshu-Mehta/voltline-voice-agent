# Copy to .env and fill in. Never commit .env.

# ---- Phase 1: the agent brain ---------------------------------------------
# Any OpenAI-compatible Chat Completions endpoint works. Default: OpenAI.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
# GPT-5 family models think before answering; for voice, keep that to a minimum.
# LLM_REASONING_EFFORT=none
# To use Gemini instead, set both of these (and LLM_MODEL to a Gemini model):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# Model that grades answers in make eval-text (a stronger model than the agent's)
JUDGE_MODEL=gpt-5.4

# Standard mode defaults
# HISTORY_TURNS=10
# RETRIEVAL_TOP_K=4
# RETRIEVAL_DENSE=true

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ---- Later phases ----------------------------------------------------------
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=

# The website reads its own env file: put NEXT_PUBLIC_API_URL in web/.env.local
# (defaults to http://localhost:8000).
