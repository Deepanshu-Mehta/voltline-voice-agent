# Copy to .env and fill in. Never commit .env.

# ---- The agent brain (LLM) ---------------------------------------------------
# Presets: groq | gemini | deepseek | openai. Each reads its own key below.
LLM_PROVIDER=gemini
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Optional overrides of the preset. Defaults: gemini -> gemini-3.5-flash-lite (reasoning "minimal"),
# groq -> openai/gpt-oss-20b (reasoning "low"). Groq is the fastest (first token ~0.6 s vs ~1.1 s)
# but its free tier caps tokens per day, which a few minutes of voice testing uses up.
# LLM_MODEL=gemini-3.5-flash
# LLM_REASONING_EFFORT=minimal
# Used when the main LLM fails before answering (rate limit, outage); empty disables it
LLM_FALLBACK_PROVIDER=deepseek
# Model that grades answers in make eval-text (default: the preset's larger model)
# JUDGE_MODEL=gemini-3.1-pro-preview

# Standard mode defaults
# HISTORY_TURNS=10
# RETRIEVAL_TOP_K=4
# RETRIEVAL_DENSE=true

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ---- Voice (Phase 2): Deepgram speech-to-text, Cartesia text-to-speech -------
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# STT_ENDPOINTING_MS=700        # Standard mode: silence that ends a turn
# TTS_MODEL=sonic-3.6
# TTS_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# ---- Later phases ----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=

# The website reads its own env file: put NEXT_PUBLIC_API_URL in web/.env.local
# (defaults to http://localhost:8000).
